# ── Workers ────────────────────────────────
WORKER_CONCURRENCY=4
LANDING_PING_INTERVAL=60
BASKET_TTL_MINUTES=20
PAYOUT_CHECK_INTERVAL=300

# ── Feature Flags ──────────────────────────
FEATURE_AIRPORT_BACKSIDE=true
FEATURE_YANDEX_INTEGRATION=false
FEATURE_AUTO_FLIGHT_TRACKING=false
FEATURE_FACE_MATCH=false
