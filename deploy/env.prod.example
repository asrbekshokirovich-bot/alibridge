BOT_WEBHOOK_SECRET=5AIDmCW4l6xVj7E3FZsPQoEMJMUrYMwdLg-flH5gGjw

# ── Mini App ───────────────────────────────
MINIAPP_URL=https://alibridge.duckdns.org
