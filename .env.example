# ============================================
# ALI BRIDGE — Environment Variables Example
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# ============================================
# Application
# ============================================
APP_NAME=ali-bridge
APP_ENV=development              # development | staging | production
APP_DEBUG=true
APP_TIMEZONE=Asia/Tashkent

# ============================================
# Telegram Bot
# ============================================
# Get from @BotFather
BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
BOT_USERNAME=alibridge_bot
BOT_WEBHOOK_URL=https://yourdomain.com/api/v1/telegram/webhook
BOT_WEBHOOK_SECRET=change-me-to-random-string

# Mini App
MINIAPP_URL=https://yourdomain.com
MINIAPP_BASE_PATH=/

# ============================================
# Backend API
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# CORS
CORS_ORIGINS=https://yourdomain.com,https://web.telegram.org

# JWT
JWT_SECRET=change-me-to-very-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=alibridge
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=alibridge
DATABASE_URL=postgresql+asyncpg://alibridge:change-me-strong-password@postgres:5432/alibridge

# ============================================
# Redis
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ============================================
# Storage (S3-compatible)
# ============================================
# Wasabi, Backblaze, AWS S3, MinIO
S3_ENDPOINT=https://s3.eu-central-1.wasabisys.com
S3_REGION=eu-central-1
S3_BUCKET=alibridge-uploads
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_USE_SSL=true

# ============================================
# OCR
# ============================================
# Google Cloud Vision (ticket OCR)
GOOGLE_VISION_CREDENTIALS_PATH=/app/secrets/google-vision.json

# PassportEye uchun maxsus sozlama yo'q
OCR_ENABLED=true

# ============================================
# SMS (Eskiz.uz)
# ============================================
SMS_PROVIDER=eskiz                # eskiz | twilio
ESKIZ_EMAIL=your-email@example.com
ESKIZ_PASSWORD=your-password
ESKIZ_FROM=4546                   # Sender ID

# ============================================
# FX Rates (Currency conversion)
# ============================================
FX_PROVIDER=cbu                   # cbu | tcmb | combined
FX_CACHE_TTL=14400                # 4 hours in seconds
FX_BASE_CURRENCY=USD

# ============================================
# Yandex Go
# ============================================
YANDEX_API_KEY=
YANDEX_API_URL=https://b2b.taxi.yandex.net
YANDEX_ENABLED=false              # true ishlatish uchun

# ============================================
# Security
# ============================================
# Random secret for QR HMAC signing
QR_HMAC_SECRET=change-me-to-random-64-byte-hex

# Encryption key (for passport storage)
ENCRYPTION_KEY=change-me-to-32-byte-base64-encoded-key

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                   # json | text
LOG_FILE=/app/logs/app.log

# ============================================
# Monitoring
# ============================================
SENTRY_DSN=                       # https://...@sentry.io/...
SENTRY_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# Background Workers
# ============================================
WORKER_CONCURRENCY=4
LANDING_PING_INTERVAL=60          # seconds
BASKET_TTL_MINUTES=20
PAYOUT_CHECK_INTERVAL=300

# ============================================
# Frontend (Mini App)
# ============================================
VITE_API_URL=https://yourdomain.com/api/v1
VITE_BOT_USERNAME=alibridge_bot
VITE_APP_VERSION=1.0.0
VITE_SENTRY_DSN=

# ============================================
# Feature Flags
# ============================================
FEATURE_AIRPORT_BACKSIDE=true
FEATURE_YANDEX_INTEGRATION=false
FEATURE_AUTO_FLIGHT_TRACKING=false  # v2
FEATURE_FACE_MATCH=false            # v2
